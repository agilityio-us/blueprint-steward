# Copy to .env beside compose.yaml and fill in. Never commit the filled file.

# The image to run: Steward's published image at a release tag (it publishes no latest), or one you built
# (docker build -t blueprint-steward:local .).
BLUEPRINT_STEWARD_IMAGE=rg.fr-par.scw.cloud/blueprint/steward:<release-tag>

# The Blueprint server Steward polls, and the repository it serves (https, as your tracker board names it).
BLUEPRINT_SERVER=https://blueprint.example.com
BLUEPRINT_REPO_URL=https://github.com/your-org/your-repo.git
# The branch Steward's own clone tracks; empty is the remote's default branch. Jobs carry their own branch.
BLUEPRINT_STEWARD_REF=

# Your organization's Blueprint API key (the Blueprint admin panel).
BLUEPRINT_STEWARD_TOKEN=
# A GitHub token that can fetch and push the served repository and open pull requests.
GH_TOKEN=
# The design agent's login, from `claude setup-token`. Steward never runs claude --bare, which drops that login.
CLAUDE_CODE_OAUTH_TOKEN=

# Jira: all three, or Steward claims no tracker jobs.
BLUEPRINT_JIRA_BASE_URL=https://your-site.atlassian.net
BLUEPRINT_JIRA_EMAIL=
BLUEPRINT_JIRA_API_TOKEN=

# Implementation routines: one URL and token pair per alias the server may dispatch to (see compose.yaml).
# BLUEPRINT_ROUTINE_TEAM_A_URL=
# BLUEPRINT_ROUTINE_TEAM_A_TOKEN=
